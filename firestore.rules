rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Video validation
    function isValidVideo(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.youtubeId is string && data.youtubeId.size() <= 50 &&
             data.userId is string &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVideo(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId && isValidVideo(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /trending/{trendingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
